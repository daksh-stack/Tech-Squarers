# Copy this file to .env and fill in real values. Never commit .env.

# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# True for local development only — must be False in production
DEBUG=True

# Comma-separated hostnames the site may be served from
# Local:      ALLOWED_HOSTS=127.0.0.1,localhost
# Production: ALLOWED_HOSTS=techsquarers.com,www.techsquarers.com
ALLOWED_HOSTS=127.0.0.1,localhost

# --- PRODUCTION ONLY (set these in Vercel Dashboard > Settings > Environment Variables) ---

# PostgreSQL connection string from Neon (https://neon.tech) or any Postgres provider
# Example: postgres://user:password@host:5432/dbname?sslmode=require
# DATABASE_URL=

# Cloudinary URL for media file uploads (https://cloudinary.com — free tier available)
# Format: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# CLOUDINARY_URL=
