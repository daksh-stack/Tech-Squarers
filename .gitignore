# =============================================================
# TechSquarers Website — .gitignore
# Covers Python, Node.js, and common OS/editor environments
# =============================================================


# =============================================================
# SECRETS & ENVIRONMENT VARIABLES
# =============================================================
.env
.env.*
!.env.example
*.pem
*.key
secrets.json


# =============================================================
# PYTHON / DJANGO
# =============================================================
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pyc
*.egg
*.egg-info/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
# Anchored to the repo root so app folders like core/lib/ are not ignored
/lib/
/lib64/

# Virtual environments
venv/
env/
.venv/
.env/
ENV/

# Django specific
*.log
# Any local database, whatever it is named — not just the default db.sqlite3
*.sqlite
*.sqlite3
*.sqlite3-journal
*.db
media/
staticfiles/
local_settings.py

# Coverage
.coverage
htmlcov/
.tox/
.pytest_cache/
nosetests.xml
coverage.xml


# =============================================================
# NODE.JS / JAVASCRIPT FRAMEWORKS
# (React, Next.js, Vue, Nuxt, Svelte, etc.)
# =============================================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
# Lockfiles are intentionally committed so every install gets identical versions

# Build output
.next/
.nuxt/
.svelte-kit/
out/
dist/
build/
.output/
.vercel/

# Next.js
next-env.d.ts

# Parcel
.parcel-cache/
.cache/

# Vite
vite.config.js.timestamp-*

# Tailwind compiled CSS (generated by `npm run build` / `npm run dev`)
static/css/output.css


# =============================================================
# EDITORS & IDEs
# =============================================================

# VS Code
.vscode/
!.vscode/extensions.json
!.vscode/settings.json.example

# JetBrains (PyCharm, WebStorm, IntelliJ)
.idea/
*.iml
*.iws
*.ipr

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim / Neovim
*.swp
*.swo
*~
.netrwhist

# Emacs
\#*\#
.\#*


# =============================================================
# OPERATING SYSTEMS
# =============================================================

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
.directory
.Trash-*


# =============================================================
# UPLOADS & USER GENERATED CONTENT
# =============================================================
uploads/
user_uploads/


# =============================================================
# DEPLOYMENT & CLOUD
# =============================================================
.vercel/
.netlify/
.serverless/
.terraform/


# =============================================================
# LOGS & TEMP FILES
# =============================================================
logs/
*.log
*.tmp
*.temp
*.bak
*.swp
*.orig
tmp/
temp/


# =============================================================
# TESTING
# =============================================================
.pytest_cache/
.nyc_output/
coverage/
test-results/
playwright-report/
